{
  "name": "aulos",
  "version": "0.1.0",
  "description": "Offline-first Android music player",
  "license": "GPL-3.0-or-later",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "format": "prettier --write .",
    "android:prebuild": "expo prebuild -p android --clean",
    "android:release": "cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.1",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.4",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
